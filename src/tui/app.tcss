

    #sidebar {
        width: 1fr;
        padding: 0 1 0 1;
    }

    #sidebar Button {
        width: 100%;
        height: auto;
    }

    #project-sort-select {
        width: 100%;
        min-width: 16;
        height: 3;
        margin: 0 0 1 0;
    }

    #project-sort-select > SelectCurrent {
        width: 100%;
        min-width: 16;
        height: 3;
        border: block $surface;
    }

    #project-list {
        background: transparent;
        padding: 0;
        scrollbar-size: 1 1;
    }

    #sidebar-rule {
        width: 1;
        margin: 0;
        padding: 0;
    }

    #sidebar-rule:hover,
    #sidebar-rule.dragging {
        color: $accent;
    }

    #project-list ListItem:hover {
        background: $surface;
    }

    #project-list ListItem {
        height: auto;
    }

    #project-list Static {
        width: 1fr;
        height: 1;
        text-wrap: nowrap;
        text-overflow: ellipsis;
    }

    .running-task-project {
        color: orange;
    }

    #project-list .project-progress {
        color: $text-muted;
    }

    #main-switcher {
        width: 4fr;
    }

    #config,
    #tasks,
    #detail {
        padding-top: 1;
    }

    #config,
    #config-tabs,
    #config-form-tab,
    #config-preview-tab {
        height: 1fr;
    }

    #project-actions {
        height: auto;
        margin-bottom: 1;
    }

    #project-actions Button {
        width: auto;
        margin-right: 1;
    }

    #tex-preview-scroll {
        height: 1fr;
    }

    #source-markdown-preview-scroll,
    #translated-markdown-preview-scroll {
        height: 1fr;
    }

    #tex-preview {
        width: 100%;
    }

    #source-markdown-preview,
    #translated-markdown-preview {
        width: 100%;
    }

    #log-tab,
    #project-log {
        height: 1fr;
    }

    #task-table,
    #terms-table,
    #errors-table {
        height: 1fr;
    }

    #entry {
        align: center top;
        padding-top: 0;
    }

    #entry-form {
        width: 100%;
        min-width: 50;
        max-width: 124;
        height: 100%;
        align-horizontal: center;
    }

    #entry-top-spacer,
    #entry-bottom-spacer {
        height: 1fr;
    }

    #entry-bottom-offset {
        height: 3;
    }

    #app-title {
        width: 100%;
        height: 6;
        content-align: center middle;
        text-style: bold;
        margin: 0 0 2 0;
    }

    #batch-input {
        width: 1fr;
        height: 3;
        margin: 0;
    }

    #entry-actions {
        width: 100%;
        height: 3;
        padding: 0 4;
    }

    #engine-mode-control {
        height: 3;
        margin-top: 1;
        padding: 0 4;
        align-horizontal: left;
    }

    #engine-mode-label {
        width: auto;
        padding: 1 0 0 1;
    }

    #engine-mode-control #engine-mode-switch .switch--slider,
    #engine-mode-control #engine-mode-label {
        color: #87CEFA;
    }

    #engine-mode-control.lite #engine-mode-switch .switch--slider,
    #engine-mode-control.lite #engine-mode-label {
        color: #FFFFFF;
    }

    #input-type-select {
        width: 22;
    }

    #start-task-button {
        width: 10;
        min-width: 10;
        height: 3;
        border: tall $border-blurred;
    }

    #start-task-button:hover,
    #start-task-button:focus {
        border: tall $border;
    }

    #entry-error {
        width: 100%;
        margin: 1 0 0 0;
    }

    #config-form {
        height: 1fr;
        padding: 1 2;
    }

    #config-fields {
        height: auto;
    }

    #config-preview {
        height: 1fr;
    }

    .config-section-title {
        text-style: bold;
        margin: 1 0 0 0;
    }

    .config-field-row {
        height: auto;
        margin: 0 0 1 0;
    }

    .config-field-block-with-hint .config-field-row {
        margin-bottom: 0;
    }

    .config-field-block {
        height: auto;
    }

    .config-field-hint {
        width: 1fr;
        height: auto;
        margin: 0 1 1 25;
        padding: 0 1 1 0;
        color: $text-muted;
    }

    .config-font-list {
        width: 1fr;
        height: auto;
        text-wrap: wrap;
        color: $text-muted;
    }

    .config-field-label {
        width: 24;
        padding: 1 1 0 0;
    }

    .config-field-row Input,
    .config-field-row Select {
        width: 1fr;
    }

    .config-field-row TextArea {
        width: 1fr;
        height: 5;
    }

    #zotero-controls {
        width: 100%;
        height: 3;
        margin-bottom: 1;
    }

    #zotero-library-select {
        width: 16;
        height: 3;
    }

    #zotero-search-input {
        width: 1fr;
        min-width: 24;
        height: 3;
    }

    #zotero-search-button,
    #import-zotero-button,
    #import-zotero-markdown-button {
        width: 8;
        min-width: 8;
        height: 3;
        border: tall $border-blurred;
    }

    #zotero-auto-match-button {
        width: 14;
        min-width: 14;
        height: 3;
        border: tall $border-blurred;
    }

    #zotero-search-button:hover,
    #zotero-search-button:focus,
    #zotero-auto-match-button:hover,
    #zotero-auto-match-button:focus,
    #import-zotero-button:hover,
    #import-zotero-button:focus,
    #import-zotero-markdown-button:hover,
    #import-zotero-markdown-button:focus {
        border: tall $border;
    }

    #import-zotero-markdown-button {
        width: 14;
        min-width: 14;
    }

    #zotero-import-rule {
        width: 1;
        height: 3;
        margin: 0 1;
    }

    #zotero-results {
        height: 1fr;
    }
    
